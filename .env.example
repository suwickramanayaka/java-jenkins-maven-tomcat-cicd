# Copy through scripts/configure.py; no secrets belong in this file.
GIT_REPOSITORY_URL=https://github.com/YOUR_USERNAME/java-jenkins-maven-tomcat-cicd.git
GIT_BRANCH=main
JENKINS_URL=http://localhost:8080/
# Keep the application local for initial validation. On AWS set this to 0.0.0.0
# and restrict access using the EC2 security group.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
